<clickhouse>
  <listen_host>127.0.0.1</listen_host>
  <http_port>8123</http_port><tcp_port>19000</tcp_port>
  <storage_configuration><disks><default><keep_free_space_bytes>16106127360</keep_free_space_bytes></default></disks></storage_configuration>
  <path>__HOME__/Library/Application Support/tokenlayer/clickhouse/</path>
  <logger>
    <level>warning</level><console>0</console><size>10M</size><count>3</count>
    <log>__HOME__/Library/Logs/tokenlayer/clickhouse.log</log>
    <errorlog>__HOME__/Library/Logs/tokenlayer/clickhouse.err.log</errorlog>
  </logger>
  <!-- reader: every query on the shared tokenlayer login (dashboard, ratchet, agents). One unbounded read of
       v_session_events_context reached the 28.8 GiB server limit on 2026-11-19; the cap stops such a read at
       8 GiB (callers may lower it, never lift it or set 0). Ship and drain write as tokenlayer_writer, uncapped. -->
  <profiles>
    <default><log_queries>0</log_queries><log_query_threads>0</log_query_threads></default>
    <reader>
      <profile>default</profile>
      <max_memory_usage>8589934592</max_memory_usage>
      <max_bytes_before_external_group_by>4294967296</max_bytes_before_external_group_by>
      <max_bytes_before_external_sort>4294967296</max_bytes_before_external_sort>
      <max_temporary_data_on_disk_size_for_query>8589934592</max_temporary_data_on_disk_size_for_query>
      <!-- Windows that follow the table order read in order instead of sorting the whole table (R5: the context
           view's 1-day token sum drops from 4.7 to 1.7 GiB). Off by default in ClickHouse 26.10. -->
      <optimize_read_in_window_order>1</optimize_read_in_window_order>
      <constraints><max_memory_usage><min>1</min><max>8589934592</max></max_memory_usage></constraints>
    </reader>
  </profiles>
  <users>
    <tokenlayer>
      <password_sha256_hex from_env="CLICKHOUSE_PASSWORD_SHA256" hide_in_preprocessed="true"/>
      <networks><ip>127.0.0.1</ip></networks><profile>reader</profile><quota>default</quota>
    </tokenlayer>
    <!-- Own password (clickhouse-writer.env), so the reader's cannot lift the cap. Rendered into this mode-600 file
         rather than the server env, so `setup.sh config` applies it by reload. -->
    <tokenlayer_writer>
      <password_sha256_hex hide_in_preprocessed="true">__WRITERHASH__</password_sha256_hex>
      <networks><ip>127.0.0.1</ip></networks><profile>default</profile><quota>default</quota>
    </tokenlayer_writer>
  </users>
  <quotas><default/></quotas>
</clickhouse>
