<?xml version="1.0" encoding="UTF-8"?>
<!-- tokenlayer-fable (M1 hub only). Install: scripts/deploy/setup.sh fable.
     bun is named in full and PATH is set: launchd's default PATH has no Homebrew, so the bin/tokenlayer wrapper's bare `bun` would not resolve.
     Secrets are read at runtime from ~/.config/tokenlayer/{hub,clickhouse}.env (mode 600), never placed here. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tokenlayer.fable</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>__REPO__/src/fable/main.ts</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>TOKENLAYER_HUB</key>
    <string>m1</string>
    <key>TOKENLAYER_HUB_URL</key>
    <string>http://127.0.0.1:8317</string>
    <key>TOKENLAYER_ENV_FILES</key>
    <string>__HOME__/.config/tokenlayer/hub.env:__HOME__/.config/tokenlayer/clickhouse.env</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/tokenlayer/fable.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/tokenlayer/fable.log</string>
</dict>
</plist>
