<?xml version="1.0" encoding="UTF-8"?>
<!-- tokenlayer-dashboard (M1 hub only), served on the tailnet by tailscale serve. Install: scripts/deploy/setup.sh dashboard.
     __ORIGIN__ (its tailnet URL) and __LOGINS__ (the tailnet logins allowed in) stay out of this public repo: setup.sh takes them
     from TOKENLAYER_DASHBOARD_ORIGIN and TOKENLAYER_DASHBOARD_LOGINS, else from the installed plist. Secrets are read at runtime from ~/.config/tokenlayer/{hub,clickhouse}.env (mode 600), never placed here. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tokenlayer.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>__REPO__/src/dashboard/main.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>TOKENLAYER_HUB</key>
    <string>m1</string>
    <key>TOKENLAYER_HUB_URL</key>
    <string>http://127.0.0.1:8317</string>
    <key>TOKENLAYER_ENV_FILES</key>
    <string>__HOME__/.config/tokenlayer/hub.env:__HOME__/.config/tokenlayer/clickhouse.env</string>
    <key>TOKENLAYER_DASHBOARD_PORT</key>
    <string>8448</string>
    <key>TOKENLAYER_DASHBOARD_ORIGIN</key>
    <string>__ORIGIN__</string>
    <key>TOKENLAYER_DASHBOARD_LOGINS</key>
    <string>__LOGINS__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/tokenlayer/dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/tokenlayer/dashboard.log</string>
</dict>
</plist>
