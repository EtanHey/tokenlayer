<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tokenlayer.hubupdate</string>
  <key>ProgramArguments</key><array>
    <string>__REPO__/bin/tokenlayer</string><string>hubupdate</string><string>check</string><string>--refresh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>__HOME__/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>10</integer></dict>
  </array>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/tokenlayer/hubupdate.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/tokenlayer/hubupdate.log</string>
</dict></plist>
