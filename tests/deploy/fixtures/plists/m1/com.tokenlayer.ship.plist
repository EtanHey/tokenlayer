<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CLICKHOUSE_USER</key>
		<string>tokenlayer_writer</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>TOKENLAYER_ENV_FILES</key>
		<string>__HOME__/.config/tokenlayer/ship.env:__HOME__/.config/tokenlayer/clickhouse.env:__HOME__/.config/tokenlayer/clickhouse-writer.env</string>
		<key>TOKENLAYER_MACHINE</key>
		<string>m1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.tokenlayer.ship</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.config/tokenlayer/app/current/bin/tokenlayer session uploader</string>
		<string>__HOME__/.config/tokenlayer/app/current/src/ship/main.ts</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/tokenlayer/ship.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/tokenlayer/ship.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>__HOME__/.config/tokenlayer/app/current</string>
</dict>
</plist>
